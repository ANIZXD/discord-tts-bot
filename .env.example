# Copy this file to .env and fill in the token.
DISCORD_TOKEN=

# Command prefix. "." means ".hello world" is spoken.
PREFIX=.

# Default Edge neural voice.
TTS_VOICE=en-US-AvaMultilingualNeural

# Slight lift so it sounds conversational rather than read aloud.
TTS_RATE=+8%
TTS_PITCH=+0Hz

# Longer messages are truncated (TTS of a 2000-char message is painful).
MAX_CHARS=300

# Locale used by the offline Windows SAPI fallback.
SAPI_VOICE=
